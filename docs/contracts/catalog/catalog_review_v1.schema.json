{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaloct/jalapao-monitor-v2/docs/contracts/catalog/catalog_review_v1.schema.json",
  "title": "Jalapão/Serras Gerais — catálogo editorial de revisão (catalog_review_v1)",
  "description": "Dataset editorial de atrativos para revisão humana. Não é schema operacional do PocketBase: todo registro é draft, sem coordenadas, sem vínculo com places e sem publicação automática.",
  "type": "object",
  "required": ["$schema", "dataset", "dataset_version", "editorial_state", "generated_from", "counts", "warnings", "records"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "dataset": {"const": "jalapao_serras_2026_review"},
    "dataset_version": {"const": "catalog_review_v1"},
    "editorial_state": {"const": "draft"},
    "generated_from": {
      "type": "object",
      "required": ["file", "sha256", "source_version", "source_date"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_version": {"type": "string", "minLength": 1},
        "source_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["records", "map_points", "previous_catalog_only", "licensed_photos", "institutional_gallery_pending", "without_licensed_photo"],
      "additionalProperties": false,
      "properties": {
        "records": {"type": "integer", "minimum": 1},
        "map_points": {"type": "integer", "minimum": 0},
        "previous_catalog_only": {"type": "integer", "minimum": 0},
        "licensed_photos": {"type": "integer", "minimum": 0},
        "institutional_gallery_pending": {"type": "integer", "minimum": 0},
        "without_licensed_photo": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "external_key", "editorial_state", "map_number", "names", "category",
        "map_sector", "tourism_region", "municipality", "cadastre_status",
        "location", "media", "sources", "equivalence", "validation_notes",
        "visit_authorized", "operational_binding", "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "external_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "editorial_state": {"const": "draft"},
        "map_number": {"type": ["integer", "null"], "minimum": 1, "maximum": 62},
        "names": {
          "type": "object",
          "required": ["map", "canonical", "aliases"],
          "additionalProperties": false,
          "properties": {
            "map": {"type": ["string", "null"]},
            "canonical": {"type": "string", "minLength": 1},
            "aliases": {"type": "array", "items": {"type": "string"}}
          }
        },
        "category": {"type": "string", "minLength": 1},
        "map_sector": {"type": "string", "minLength": 1},
        "tourism_region": {"type": "string", "minLength": 1},
        "municipality": {
          "type": "object",
          "required": ["name", "status"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": ["string", "null"]},
            "status": {"enum": ["pendente", "corroborado", "herdado_catalogo_anterior"]}
          }
        },
        "cadastre_status": {
          "enum": [
            "somente_mapa", "documentado", "documentado_por_fonte",
            "documentado_em_fonte_nao_governamental", "documentado_em_fonte_fotografica",
            "pendente_de_identificacao"
          ]
        },
        "location": {
          "type": "object",
          "required": ["latitude", "longitude", "google_maps_search_url", "google_place_id"],
          "additionalProperties": false,
          "properties": {
            "latitude": {"const": null},
            "longitude": {"const": null},
            "google_maps_search_url": {"type": ["string", "null"]},
            "google_place_id": {"const": null}
          }
        },
        "media": {
          "type": "object",
          "required": ["photo_status", "photo", "official_gallery_url"],
          "additionalProperties": false,
          "properties": {
            "photo_status": {"enum": ["foto_licenciada", "sem_foto_licenciada", "galeria_institucional_uso_pendente"]},
            "photo": {"type": ["object", "null"], "$ref": "#/$defs/photo"},
            "official_gallery_url": {"type": ["string", "null"]}
          }
        },
        "sources": {
          "type": "object",
          "required": ["map", "institutional"],
          "additionalProperties": false,
          "properties": {
            "map": {"type": ["string", "null"]},
            "institutional": {"type": ["string", "null"]}
          }
        },
        "equivalence": {
          "type": "object",
          "required": ["status", "counterpart_key"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["novo", "confirmada_por_nome", "possivel", "original_somente"]},
            "counterpart_key": {"const": null}
          }
        },
        "validation_notes": {"type": "array", "items": {"type": "string"}},
        "visit_authorized": {"const": null},
        "operational_binding": {"const": null},
        "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "photo": {
      "type": "object",
      "required": ["url", "source_page", "file_name", "author", "license", "license_url", "review_status", "attribution", "observation"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "source_page": {"type": ["string", "null"]},
        "file_name": {"type": ["string", "null"]},
        "author": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "license_url": {"type": ["string", "null"]},
        "review_status": {"type": "string", "minLength": 1},
        "attribution": {"type": ["string", "null"]},
        "observation": {"type": ["string", "null"]}
      }
    }
  }
}
